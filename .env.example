# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# docker-compose.yml reads this file directly (env_file: .env), so nothing
# else needs to change to point the stack at your MinIO / Keycloak.

# ---------------------------------------------------------------------------
# MinIO — where raw and encrypted files live
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio-api.example.com
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
# true for HTTPS endpoints, false for plain HTTP (e.g. local MinIO on :9000)
MINIO_SECURE=true

# Bucket the anonymizer watches for new raw uploads
SOURCE_BUCKET=demo-data
# Bucket the anonymizer writes encrypted output to, and serves reads from
DESTINATION_BUCKET=encrypted-files

# How often (seconds) the background monitor polls SOURCE_BUCKET for new files
POLL_INTERVAL=5

# A file in SOURCE_BUCKET with no matching ABAC policy is retried every
# POLL_INTERVAL; if it still has no policy after POLICY_GRACE_SECONDS, it's
# deleted as orphaned. Applies to every file, no prefix filtering. Files that
# DO have a policy are encrypted and their raw copy removed immediately —
# this only cleans up uploads nobody ever created a policy for.
POLICY_GRACE_SECONDS=60

# ---------------------------------------------------------------------------
# Auth — JWT verification (Keycloak or any RS256-signed issuer)
# ---------------------------------------------------------------------------
# Your identity provider's RS256 public key, PEM format. Required in
# production. If unset, the app falls back to the bundled dev key
# (dev_keys/public.pem) and issues its own tokens via /api/v1/dev/token —
# fine for local testing, not for anything real.
#
# .env files can't hold real newlines, so paste the PEM as ONE line with
# literal \n where the real newlines go — settings.py unescapes this
# automatically. Example (truncated):
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----\n
JWT_PUBLIC_KEY=

# Dev-only. Leave unset in any environment reachable by anyone but you —
# setting this enables POST /api/v1/dev/token, which mints valid tokens for
# ANY organization/access combo with no further checks.
JWT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# MongoDB is intentionally not here. It's purely internal state (policies,
# org key material, wrapped dataset keys) — no partner system ever talks to
# it directly, so its credentials are fixed in docker-compose.yml / the mongo
# image instead of exposed in this file. See settings.py / docker-compose.yml
# if you're pointing the app at an external MongoDB instead of the bundled one.
# ---------------------------------------------------------------------------
